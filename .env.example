# Variables de entorno del backend de Apparchar. Copia este archivo como .env y
# llena los valores. .env NUNCA se sube al repositorio (está en .gitignore).
# Todas son opcionales en desarrollo: sin ellas el servidor arranca con PGlite y
# valores de prueba (y lo avisa en la consola). En producción, JWT_SECRETO y
# PASARELA_CLAVE son obligatorias.

# Puerto HTTP del backend. Por defecto: 3000
PORT=

# Entorno de ejecución: development | test | production
NODE_ENV=

# Cadena de conexión a PostgreSQL 17. Formato: postgres://USUARIO:CLAVE@SERVIDOR:5432/BASE
# Si se deja vacía, el backend usa PGlite (PostgreSQL embebido) y guarda la base en .datos/pglite.
DATABASE_URL=

# Carpeta de PGlite cuando no hay DATABASE_URL. Por defecto: .datos/pglite
PGLITE_DIR=

# Clave secreta con la que el servidor firma y verifica los tokens JWT (HS256).
# Si se deja vacía, el servidor inventa una clave aleatoria cada vez que arranca
# (los tokens dejan de servir al reiniciarlo). Una cadena larga y aleatoria; por
# ejemplo, la salida de:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRETO=

# Clave compartida con la pasarela de pagos: confirmarPagoOrden la exige en la
# cabecera X-Clave-Pasarela (decisiones D-13 y D-20). Solo la conoce el servidor.
PASARELA_CLAVE=

# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
# Por defecto, cualquiera (*).
CORS_ORIGIN=

# Caché en Valkey/Redis. Formato: redis://SERVIDOR:6379. Vacía: sin caché (la
# API consulta siempre la base). En compose y en Render se define sola.
REDIS_URL=

# Segundos que la cartelera pública (GET /eventos) vive en la caché. Por defecto: 30
CACHE_CARTELERA_SEGUNDOS=

# En qué proxies se confía para leer la IP del cliente (X-Forwarded-For): un
# número de saltos («1» en Render) o una lista como la de compose
# («loopback,linklocal,uniquelocal»: los de redes privadas). Vacía: ninguno.
TRUST_PROXY=

# No se definen a mano: el commit desplegado lo pone el CI al construir la imagen
# (COMMIT_SHA) o Render al desplegar (RENDER_GIT_COMMIT); /salud lo informa.
# COMMIT_SHA=
# RENDER_GIT_COMMIT=

# ---------------------------------------------------------------------------
# Solo para docker compose (compose.yaml). Todas tienen un valor por defecto que
# sirve en local; en un servidor público hay que definirlas.
# ---------------------------------------------------------------------------

# Usuario, clave y nombre de la base del servicio «db». La base no se publica
# fuera de la red interna del compose; aun así, en un servidor cambie la clave.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Puertos del host donde se publica el proxy (el único servicio expuesto).
# Por defecto 8080 y 8443; en un servidor con dominio: 80 y 443.
PUERTO_HTTP=
PUERTO_HTTPS=

# Dominio del proxy. Vacío o :80: HTTP en local. Con un dominio real que apunte
# al servidor (por ejemplo apparchar.ejemplo.com), Caddy obtiene y renueva solo
# el certificado HTTPS de Let's Encrypt.
DOMINIO=

# Imagen de la API que usa compose. Por defecto se construye en local
# (apparchar-api:local); para usar la publicada por el CI:
#   ghcr.io/elverrianoes-collab/apparchar:latest
IMAGEN_API=
