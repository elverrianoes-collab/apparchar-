# .env del proyecto en el VPS. Se copia como <carpeta del proyecto>/.env con
# permisos 600 y dueño el usuario del proyecto. Nunca se versiona.
# Los valores con __…__ se reemplazan al instalar (ver despliegue/vps/PROMPT-instalar-proyecto.md).

# --- Compose: archivos y nombre propio del proyecto (aísla contenedores, redes y volúmenes)
COMPOSE_FILE=compose.yaml:compose.vps.yaml
COMPOSE_PROJECT_NAME=__NOMBRE__

# --- Dónde escucha el proxy del proyecto. Solo lo usa el proxy del servidor, que pone
# el HTTPS del subdominio. 127.0.0.1 si ese proxy corre en el servidor; la puerta de
# enlace de docker0 (por ejemplo 172.17.0.1) si corre dentro de un contenedor.
VPS_ENLACE=127.0.0.1
VPS_PUERTO=__PUERTO__

# --- Imagen. IMAGEN_API la fija el agente de despliegue en cada versión.
IMAGEN_BASE=ghcr.io/elverrianoes-collab/proyecto-tecweb
IMAGEN_API=
RAMA=main

# --- Secretos: se generan en el servidor (openssl rand -base64 48 | tr -d '\n/+=').
JWT_SECRETO=__GENERAR__
PASARELA_CLAVE=__GENERAR__
POSTGRES_USER=__NOMBRE__
POSTGRES_PASSWORD=__GENERAR__
POSTGRES_DB=__NOMBRE__

# --- La web y la API se sirven en el mismo origen. __SUBDOMINIO__ es el nombre del
# sitio público: un subdominio propio (proyecto.midominio.com) o el dominio que
# comparte con otra aplicación cuando el proyecto vive en una subcarpeta.
CORS_ORIGIN=https://__SUBDOMINIO__

# --- Subcarpeta pública, solo si el proxy del servidor publica el proyecto en
# https://<dominio>/<subcarpeta> (por ejemplo /proyecto). Vacío con subdominio propio.
RUTA_BASE=__RUTA_BASE__
